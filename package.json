{
  "name": "immigration-ai-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "비자 행정사용 RAG AI 챗봇 — 모바일판 (클라우드 LLM 전용)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "ios:init": "tauri ios init",
    "ios:sim": "bash scripts/ios-sim.sh",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "ios:build:sim": "tauri ios build --debug --target aarch64-sim --ci",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
